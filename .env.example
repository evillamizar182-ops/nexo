# ─── Core ───────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (PostgreSQL) ──────────────────────
DATABASE_URL=postgresql://user:password@host:5432/nexo_ia

# ─── Redis (Upstash) ───────────────────────────
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ─── Auth ───────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
HMAC_KEY=
# Exactly 64 hex chars (32 bytes): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PHONE_ENC_KEY=

# ─── AI (Anthropic) ────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─── WhatsApp (Meta Cloud API) ─────────────────
WHATSAPP_VERIFY_TOKEN=your_verify_token
WHATSAPP_APP_SECRET=your_app_secret_for_hmac
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ─── Google APIs (opcional) ────────────────────
GOOGLE_OAUTH_CLIENT_ID=your_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=your_refresh_token

# ─── Seguridad / flags ─────────────────────────
# Orígenes permitidos por CORS (separados por coma). Ej: https://panel.tudominio.com
CORS_ORIGINS=
# Respuestas de IA simuladas (sin llamadas reales a Anthropic/Meta).
USE_MOCKS=false
ENABLE_AUDIO_HANDLER=false
# El webhook SIEMPRE valida firma HMAC salvo que esto sea true (solo para tests locales).
# DEBE ser false en producción (el arranque falla si se pone true en prod).
WEBHOOK_ALLOW_UNSIGNED=false

# ─── Admin & Control ───────────────────────────
# Números admin (separados por coma) para comandos "!" por WhatsApp.
ADMIN_NUMBERS=573001234567,573009876543
ADMIN_PHONE=573001234567
# Credenciales del usuario admin del dashboard (usadas por el seed).
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=

# ─── Resilience (Circuit Breaker) ──────────────
CB_FAILURE_THRESHOLD=3
CB_RECOVERY_TIMEOUT=30000
