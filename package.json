{
  "name": "nexo-ia-backend",
  "version": "1.0.0",
  "description": "Nexo IA - Senior Enterprise Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate:prod": "prisma generate --schema=prisma/schema.production.prisma",
    "db:push:prod": "prisma db push --schema=prisma/schema.production.prisma",
    "prisma:migrate:prod": "prisma migrate deploy --schema=prisma/schema.production.prisma",
    "seed": "ts-node src/scripts/seed.ts",
    "test:smoke": "ts-node src/scripts/smoke-test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@fastify/cookie": "^11.1.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^5.14.0",
    "@upstash/redis": "^1.31.1",
    "axios": "^1.16.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.10.0",
    "googleapis": "^173.0.0",
    "luxon": "^3.4.4",
    "node-cron": "^4.6.0",
    "pino": "^9.1.0",
    "prom-client": "^15.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.19.40",
    "pino-pretty": "^11.3.0",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
